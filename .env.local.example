# Copy to .env.local and fill in. Restart `npm run dev` after any change —
# Next.js only reads this file at startup.

# ─────────────────────────────────────────────────────────────────────────
# Supabase — required. Nothing works without these.
# Project Settings → API in the Supabase dashboard.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Service role bypasses RLS. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────
# Site origin — required for Stripe redirects.
# Falls back to VERCEL_URL, then http://localhost:3000. Set it explicitly in
# production or Stripe will send payers back to the wrong host.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────
# Stripe — required for paid play-session sign-ups.
# ─────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...

# The webhook is the source of truth for whether a sign-up is paid — the
# browser redirect is not. Without a working webhook, sign-ups stay `pending`
# forever and the success page shows "We're confirming your payment."
#
# LOCAL: Stripe cannot reach localhost, so forward with the CLI:
#   stripe listen --forward-to localhost:3000/api/stripe/session-webhook
# Use the whsec_... that command prints. It is DIFFERENT from the secret on a
# dashboard endpoint — mixing them up fails signature verification with a 400.
#
# DEPLOYED: use the signing secret from your dashboard webhook endpoint,
# pointed at https://your-domain/api/stripe/session-webhook and subscribed to
# checkout.session.completed and checkout.session.expired.
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────────────
# Resend — transactional email (sign-up confirmations, contact form).
# Without this, sends fail silently: they're fire-and-forget, so payments and
# sign-ups still succeed but no email is delivered.
# The from-address is hardcoded in lib/resend/emails.ts and uses Resend's
# shared onboarding@resend.dev domain until you verify your own.
# ─────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Where admin notifications go (new sign-up, contact message, expedition interest).
CLIENT_NOTIFICATION_EMAIL=you@example.com

# ─────────────────────────────────────────────────────────────────────────
# Optional — each gates one feature; the rest of the site is unaffected.
# ─────────────────────────────────────────────────────────────────────────

# Chatbot (/api/chat). Without it the endpoint returns 500 with a friendly
# "Nell is unavailable right now" message instead of calling the model.
GROQ_API_KEY=gsk_...

# Admin CMS auto-translate (ES ↔ EN). Without it the action THROWS when the
# button is pressed — the rest of the CMS still works.
OPENAI_API_KEY=sk-...

# WhatsApp contact number, digits only with country code (no + or spaces).
# Used by the Footer and contact page; those links are omitted when unset.
NEXT_PUBLIC_WHATSAPP_PHONE=18095551234

# Google Places autocomplete. Read only by components/AddressAutocomplete.tsx,
# which nothing currently renders — leave unset unless you wire that back up.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key

# HMAC key for the signed membership-cache cookie read in proxy.ts. Only
# needed once /member/* routes are enabled. Any long random string:
#   openssl rand -base64 32
MEMBERSHIP_COOKIE_SECRET=

# Dev only: set to "true" to bypass auth and render as a logged-in admin.
# Ignored when NODE_ENV=production.
DEV_BYPASS_AUTH=false
